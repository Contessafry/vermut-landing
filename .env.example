# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.
# All are optional; site.config.ts falls back to the defaults shown.
NEXT_PUBLIC_SITE_URL=https://vermut.example          # canonical URL (falls back to VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_GITHUB_URL=https://github.com/PLACEHOLDER/vermut
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/PLACEHOLDER/vermut/releases/latest
NEXT_PUBLIC_VERSION=1.0.0
