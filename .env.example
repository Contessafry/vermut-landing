# Copy to .env.local for local dev, or set in Vercel → Project → Settings → Environment Variables.
# All optional; site.config.ts falls back to the defaults shown. Empty = hidden on the page.

# Canonical origin (falls back to VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_SITE_URL=https://vermut.example
# App source repo (no trailing slash)
NEXT_PUBLIC_GITHUB_URL=https://github.com/PLACEHOLDER/vermut
# Release asset name; download = <repo>/releases/latest/download/<name>
NEXT_PUBLIC_DMG_NAME=Vermut.dmg
# Override the full DMG URL (optional)
NEXT_PUBLIC_DOWNLOAD_URL=
# e.g. "48 MB"
NEXT_PUBLIC_DMG_SIZE=
# Defaults to <dmg url>.sha256; set to "off" to hide
NEXT_PUBLIC_CHECKSUM_URL=
NEXT_PUBLIC_VERSION=1.0.0
# "true" once releases are signed + notarized (hides the Gatekeeper steps)
NEXT_PUBLIC_NOTARIZED=false
# Homebrew cask token, e.g. vermut (empty hides the brew line)
NEXT_PUBLIC_BREW_CASK=
# Search Console / Bing Webmaster verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
