# Copy to .env.local for local dev, or set in Vercel → Project → Settings → Environment Variables.
# All optional. Release data comes from the GitHub API at build time; these are fallbacks.

# Canonical origin. Production: set to https://vermut.vercel.app (or the custom
# domain). Unset locally → VERCEL_PROJECT_PRODUCTION_URL, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/Contessafry/Vermut
# Release fallbacks: leave unset so the GitHub API (releases/latest) wins.
# Defaults in site.config.ts: v1.1.2 values, download URL = .../releases/latest
# NEXT_PUBLIC_VERSION=1.1.2
# NEXT_PUBLIC_DMG_NAME=Vermut-1.1.2.dmg
# NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/Contessafry/Vermut/releases/latest
# NEXT_PUBLIC_DMG_SIZE_BYTES=2484547
# NEXT_PUBLIC_DMG_SHA256=bcf8ad45218d2aee67a1cbb92cc5870cac8654c967438ec7e5d4aa3128885616
# "true" once releases are signed + notarized (hides the Gatekeeper steps)
NEXT_PUBLIC_NOTARIZED=false
# Homebrew cask token (empty hides the brew line)
NEXT_PUBLIC_BREW_CASK=
NEXT_PUBLIC_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/Contessafry/Vermut/main/install.sh
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# PayPal donate link (default paypal.me/contessafry; set "" in code to hide the button)
NEXT_PUBLIC_DONATE_PAYPAL_URL=https://www.paypal.me/contessafry

# Download click counts (Vercel Blob). Connecting a Blob store on the project
# sets BLOB_READ_WRITE_TOKEN (and BLOB_STORE_ID on Vercel). Leave unset locally:
# /api/download still 302s to GitHub and skips counting.
BLOB_READ_WRITE_TOKEN=
# Optional. Default is private. Set to "public" if the Blob store was created as public.
# BLOB_ACCESS=private
# Secret for GET /api/download-stats. Unset = the endpoint 404s.
DOWNLOAD_STATS_SECRET=
